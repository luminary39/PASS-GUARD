# ==========================================
# PASS-GUARD - .gitignore
# ==========================================

# ------------------------------------------
# Executables & Binaries (as requested)
# ------------------------------------------
*.exe
*.exe.manifest
*.out
*.bin
*.app

# ------------------------------------------
# Documents & Reports (as requested)
# ------------------------------------------
*.pdf
*.docx
*.pptx
*.xlsx

# ------------------------------------------
# C / C++ Compilation & Object Files
# ------------------------------------------
*.o
*.obj
*.i
*.s
*.d
*.gch
*.pch

# Libraries & Dynamic Links
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll

# Debugging Symbols & Profiling
*.pdb
*.idb
*.ilk
*.dSYM/
*.suo
*.gcno
*.gcda
gmon.out

# ------------------------------------------
# Build Directories & Output Folders
# ------------------------------------------
bin/
obj/
build/
dist/
out/
target/
cmake-build-*/
[Bb]uild*/

# ------------------------------------------
# IDEs, Editors & Tooling
# ------------------------------------------
# Visual Studio
.vs/
*.vcxproj.user
*.vcxproj.filters

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.code-workspace

# CLion / JetBrains
.idea/
cmake-build-debug/
cmake-build-release/

# Other Editors
*.swp
*.swo
*~

# ------------------------------------------
# Logs, Temp Files & Caches
# ------------------------------------------
*.log
*.tmp
*.temp
*.bak

# ------------------------------------------
# Environment & Secrets
# ------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------
# Large Wordlists, Datasets & Dumps
# (e.g., SecLists, RockYou, password dumps)
# ------------------------------------------
*.dump
*.dict
wordlists/
seclists/
# Oversized monolithic master wordlists (>100MB exceeds GitHub limits)
PASS-GUARD-PASSWORD-MASTER.txt
Common Passwords/PASS-GUARD-PASSWORD-MASTER.txt

# ------------------------------------------
# Operating System Specific Files
# ------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
.directory
